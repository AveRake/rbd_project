# Центральный офис (источник НСИ, master)
[mysqld]
server-id = 1
log-bin
binlog-do-db = campusrent
binlog-format = ROW
# РБОК: ЦО принимает изменения таблиц клиентов из филиала
replicate-do-table = campusrent.universities
replicate-do-table = campusrent.departments
replicate-do-table = campusrent.representatives
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
datadir     = /var/lib/mysql
secure-file-priv = NULL
default-authentication-plugin = mysql_native_password

# Клиент mysql внутри контейнера должен работать в utf8mb4:
# в образе локаль C, и без этого параметра клиент переключается на latin1,
# из-за чего русский текст в командах docker exec обрезается с ошибкой 1406.
[client]
default-character-set = utf8mb4
